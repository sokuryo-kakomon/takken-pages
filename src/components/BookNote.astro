---
import books from '../data/books.json';
import { site } from '../lib/data';
import type { Question } from '../lib/types';

// 問題ページの解説の後に置く本の案内（Amazon アソシエイト）。1ページ2つまで。
interface Props { q: Question }
const { q } = Astro.props;
const items = books.items as Record<string, { asin: string; title: string; by: string; desc: string }>;
const main = items[books.main];
const kijutsu = books.kijutsu && (q as any).kind && (q as any).kind !== 'choice' ? items[books.kijutsu] : null;
const href = (asin: string) => `https://www.amazon.co.jp/dp/${asin}/?tag=${site.amazonTag}`;
const row = 'flex flex-wrap items-baseline gap-x-3 gap-y-0.5 no-underline text-ink hover:text-moss';
---
{site.amazonTag && (
<aside class="mt-6 rounded-dojo border border-line bg-card px-4 py-3 text-sm space-y-2.5">
  <a href={href(main.asin)} target="_blank" rel="sponsored noopener" class={row}>
    <span class="w-full text-[.7rem] text-ink-faint tracking-wider">PR ・ 「{q.category}」を本で固めるなら</span>
    <b>{main.title}</b><span class="text-xs text-ink-soft">{main.by}</span><span class="ml-auto text-moss text-xs">Amazon で見る ›</span>
  </a>
  {kijutsu && (
    <a href={href(kijutsu.asin)} target="_blank" rel="sponsored noopener" class={row + ' border-t border-line pt-2.5'}>
      <span class="w-full text-[.7rem] text-ink-faint tracking-wider">PR ・ 多肢選択式・記述式は判例の言い回しで</span>
      <b>{kijutsu.title}</b><span class="text-xs text-ink-soft">{kijutsu.by}</span><span class="ml-auto text-moss text-xs">Amazon で見る ›</span>
    </a>
  )}
  <a href="/books/" class="block text-xs text-ink-soft">ほかの参考書・問題集 ›</a>
</aside>
)}
