---
import Base from '../layouts/Base.astro';
import { pageTitle, SITE_NAME } from '../lib/data';
// 11-04 本人が通し読み済み。11-16 提供内容を「間違えた問題の解き直しは無料」（本人の決め）に合わせて書き換え・解約の窓口を足した。メールは ここの登記簿 と共通の info@
const rows: [string, string][] = [
  ['販売事業者', '請求があった場合、遅滞なく開示します（info@kokonotoukibo.jp へご連絡ください）'],
  ['運営責任者', '請求があった場合、遅滞なく開示します（info@kokonotoukibo.jp へご連絡ください）'],
  ['所在地', '請求があった場合、遅滞なく開示します（info@kokonotoukibo.jp へご連絡ください）'],
  ['電話番号', '請求があった場合、遅滞なく開示します（info@kokonotoukibo.jp へご連絡ください）'],
  ['メールアドレス', 'info@kokonotoukibo.jp（運営者が同じ「ここの登記簿」と共通の窓口です）'],
  ['販売価格', '有料プラン：月額 980円（税込）'],
  ['提供内容', 'AI に質問（最上位の AI〔Claude Opus〕が回答・1日15回・1か月90回まで）、AI の弱点分析（AI に質問の回数に含みます）、成績表の弱点まとめ。このサイト専用で、姉妹サイトの有料プランとは別の契約です。過去問・解説・成績表・模擬試験（年度ごと）・間違えた問題の解き直しは有料プランに入らなくても無料で使えます'],
  ['商品代金以外の必要料金', 'インターネット接続にかかる通信料はお客様のご負担となります'],
  ['支払方法', 'クレジットカード（Stripe による決済）'],
  ['支払時期', 'お申し込み時に初回分をお支払いいただき、以後は毎月同じ日に自動で更新・決済されます'],
  ['提供時期', '決済完了後、すぐに利用コードを表示し、ご利用いただけます'],
  ['解約', '「有料プラン」ページの「契約の確認・カード変更・解約」（申し込んだ端末で、ページの下に出ます）からいつでも解約できます。解約後も、支払い済みの期間の終わりまではご利用いただけます。端末を替えた・利用コードが分からない等でうまくいかない時は、info@kokonotoukibo.jp へご連絡ください'],
  ['返品・返金', 'デジタルサービスの性質上、支払い済みの料金の返金（日割りを含む）はいたしません。ただし当方の責による不具合で利用できなかった場合はご相談ください'],
  ['動作環境', '最新版の Chrome・Safari・Edge・Firefox'],
];
---
<Base title={pageTitle('特定商取引法に基づく表記')} description={`${SITE_NAME}（有料プラン）の特定商取引法に基づく表記`} path="/tokushoho/">
  <main class="max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-ink-soft mb-2"><a href="/">トップ</a> ／ 特定商取引法に基づく表記</nav>
    <h1 class="text-2xl mb-4">特定商取引法に基づく表記</h1>
    <div class="card p-6 qhtml">
      <table>
        {rows.map(([k, v]) => <tr><th class="whitespace-nowrap align-top">{k}</th><td>{v}</td></tr>)}
      </table>
    </div>
  </main>
</Base>
