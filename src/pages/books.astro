---
import Base from '../layouts/Base.astro';
import books from '../data/books.json';
import { pageTitle, site } from '../lib/data';

// おすすめ参考書・問題集（Amazon アソシエイト）。
const href = (asin: string) => `https://www.amazon.co.jp/dp/${asin}/?tag=${site.amazonTag}`;
const items = books.items as Record<string, { asin: string; title: string; by: string; desc: string }>;
---
<Base title={pageTitle('おすすめ参考書・問題集')} description="宅建士試験の独学で使われている定番のテキスト・問題集（2027年度版）。" path="/books/">
  <main class="max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-ink-soft mb-2"><a href="/">トップ</a> ／ おすすめ参考書・問題集</nav>
    <h1 class="text-2xl mb-2">おすすめ参考書・問題集</h1>
    <p class="text-sm text-ink-soft mb-6">独学で使われている定番だけを選んでいます。<span class="text-ink-faint">（PR：リンク先は Amazon です）</span></p>
    <div class="space-y-8">
      {books.groups.map((g) => (
        <section>
          <h2 class="text-lg mb-1">{g.h}</h2>
          <p class="text-sm text-ink-soft mb-3">{g.note}</p>
          <div class="space-y-2">
            {g.keys.map((k) => { const b = items[k]; return (
              <a href={href(b.asin)} target="_blank" rel="sponsored noopener" class="card block p-4 no-underline text-ink hover:border-moss">
                <div class="flex flex-wrap items-baseline gap-x-3"><b>{b.title}</b><span class="text-xs text-ink-soft">{b.by}</span><span class="ml-auto text-xs text-moss">Amazon で見る ›</span></div>
                <p class="text-sm text-ink-soft mt-1">{b.desc}</p>
              </a>
            ); })}
          </div>
        </section>
      ))}
    </div>
    <p class="text-xs text-ink-faint mt-8 leading-relaxed">当サイトは Amazon.co.jp を宣伝しリンクすることによって紹介料を得られる、Amazon アソシエイト・プログラムの参加者です。</p>
  </main>
</Base>
