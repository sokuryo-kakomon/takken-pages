---
import Base from '../layouts/Base.astro';
import TopHome from '../components/TopHome.astro';
import { SITE_NAME, categories, shiQuestions, site, yearSpan } from '../lib/data';

// トップ。宅建試験の過去問（R7 から新しい順）
const total = shiQuestions.length;
const span = yearSpan('shi');
const title = `${SITE_NAME}｜宅建 過去問 ${span.short} 全${total}問`;
const description = `宅建（宅地建物取引士資格試験）の過去問 ${span.long} 全${total}問を、問題文は原文のまま1問1ページで演習できます。解答を選ぶと即判定、年度別・分野別の成績を自動記録。登録不要・無料。`;
const steps = [
  { n: '一', t: '年度か分野を選ぶ', d: '年度ごとに50問を通しで解くか、苦手な分野だけ絞るか。未回答・要復習だけを出すこともできます。' },
  { n: '二', t: '解答を選ぶ', d: '選択肢を押すとその場で正誤が出ます。結果は端末に自動で記録され、登録は要りません。' },
  { n: '三', t: '正解を確かめる', d: '正解番号は試験実施機関の公表どおり。複数正解・正解なしの問も、公表どおりに判定します。' },
  { n: '四', t: '成績表で弱点を絞る', d: '年度別・分野別の正答率と、間違えた問題の一覧。要復習の問題だけをもう一度解けます。' },
];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: site.url + '/', description,
  inLanguage: 'ja',
};
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <TopHome exam="shi" bg="宅">
  <!-- つかい方 -->
  <section id="howto">
    <h2 class="text-2xl mb-4">このサイトのつかい方</h2>
    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <li class="card p-5">
          <div class="serif text-3xl text-moss mb-1">{s.n}</div>
          <h3 class="text-base mb-1">{s.t}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 掲載の方針 -->
  <section>
    <div class="card p-6 md:p-8 md:grid md:grid-cols-2 md:gap-10">
      <div>
        <h2 class="text-2xl mb-3">掲載の方針</h2>
        <ul class="text-sm text-ink-soft leading-relaxed space-y-2 list-disc pl-5">
          <li><b class="text-ink">問題文は原文のまま。</b>一般財団法人 不動産適正取引推進機構が公表している試験問題を、言い回しを変えずに載せています。出典は各問題のページに記載しています。</li>
          <li><b class="text-ink">正解番号は公表どおり。</b>試験後に複数正解・正解なしとされた問も、公表どおりに判定します。</li>
          <li><b class="text-ink">1問1ページ。</b>年度と問番号で、どの問題にもすぐ戻れます（例：令和7年度 問1 は /r07/q1/）。</li>
          <li><b class="text-ink">解説は準備中です。</b>出題当時の法令と今の法令が違う問は、改正の注意書きと今の法令での答えを添える予定です。</li>
        </ul>
      </div>
      <div class="mt-8 md:mt-0">
        <h2 class="text-2xl mb-3">{span.n}回分{total}問の出題分野</h2>
        <p class="text-sm text-ink-soft mb-3">問番号による例年の区分で集計したものです。</p>
        <div class="qhtml"><div class="tbl-wrap"><table>
          <thead><tr><th>分野</th><th class="text-right">問題数</th><th class="text-right">割合</th></tr></thead>
          <tbody>
            {categories.map((c) => (
              <tr><td><a href={`/practice/?cat=${c.slug}`} class="no-underline">{c.icon} {c.name}</a></td><td class="text-right">{c.count}問</td><td class="text-right">{(c.count / total * 100).toFixed(1)}%</td></tr>
            ))}
          </tbody>
        </table></div></div>
        <p class="text-sm text-ink-soft leading-relaxed mt-3">
          1回50問のうち<b class="text-ink">宅建業法が20問</b>（問26〜45）、権利関係が14問、法令上の制限が8問、税・価格の評定が3問。問46〜50 の5問は登録講習の修了者が免除されます。
        </p>
      </div>
    </div>
  </section>

  </TopHome>
</Base>
